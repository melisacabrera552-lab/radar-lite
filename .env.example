# ==============================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO · RADAR LITE
# ==============================================================================
# Copia este archivo como ".env" en la misma carpeta antes de iniciar la app.
# También podés configurar estas claves directamente desde la pestaña "Ajustes"
# dentro de la interfaz web de la aplicación.

# ------------------------------------------------------------------------------
# 1. GOOGLE GEMINI AI (REQUERIDO - GRATUITO)
# ------------------------------------------------------------------------------
# Obtén tu clave gratis en: https://aistudio.google.com/apikey
# Se usa para análisis de nichos, auditorías digitales y redacción de mensajes.
GEMINI_API_KEY="pega_aqui_tu_clave_de_gemini"

# ------------------------------------------------------------------------------
# 2. GOOGLE CLOUD: PLACES API (NEW) & PAGESPEED INSIGHTS API
# ------------------------------------------------------------------------------
# Crea una clave en Google Cloud Console con estas 2 APIs habilitadas:
#   1) Places API (New)
#   2) PageSpeed Insights API
# (Si se deja vacío, la app usa el motor inteligente de Gemini para búsquedas)
GOOGLE_CLOUD_API_KEY=""

# ------------------------------------------------------------------------------
# 3. PUERTO DEL SERVIDOR LOCAL
# ------------------------------------------------------------------------------
PORT=3000
APP_URL="http://localhost:3000"
